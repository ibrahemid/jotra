---
import Prose from '../../layouts/Prose.astro';
import { getDocsPage } from '../../data/docs-topics';
import release from '../../data/release.json';
import { getReleaseCommands, getReleaseNames } from '../../lib/release-names';

const page = getDocsPage('install');
const commands = getReleaseCommands(getReleaseNames(release));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Prose title={page.title} description={page.description} path={page.path}>
  <p>Builds for macOS, Windows and Linux are on the <a href={`${base}/download/`}>download page</a> with their checksums, or from a package manager:</p>
  <pre><code>{commands.brewTrust}
{commands.brewInstallCask}
winget install -e --id ibrahemid.Writ
curl -fsSL https://github.com/ibrahemid/jotra/raw/main/install.sh | sh</code></pre>
</Prose>
